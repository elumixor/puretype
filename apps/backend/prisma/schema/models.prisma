model User {
  id        String   @id @default(cuid())
  // Email is null for anonymous users created via /auth/anonymous.
  // On Google/Apple sign-in we populate this field (or merge into an
  // existing row), so `email IS NULL` doubles as the anonymous marker.
  email     String?  @unique
  name      String?
  projects  Project[]
  tasks     Task[]
  events    AnalyticsEvent[]
  telegramLinks     TelegramLink[]
  telegramLinkCodes TelegramLinkCode[]
  googleAccounts    GoogleAccount[]
  notionAccounts    NotionAccount[]
  calendarSources   CalendarSource[]
  notionSources     NotionSource[]
  createdAt DateTime @default(now())
}

// A connected Google account (full OAuth, Calendar scope) — distinct from the
// Google *sign-in* which only ever sees an ID token. A user may connect many.
model GoogleAccount {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  googleUserId String   // Google account 'sub'
  email        String
  accessToken  String
  refreshToken String?  // only issued on first consent — kept across refreshes
  expiresAt    DateTime // access-token expiry
  scope        String
  createdAt    DateTime @default(now())
  calendarSources CalendarSource[]

  @@unique([userId, googleUserId])
  @@index([userId])
}

// Binds one calendar of a Google account to a project. Its events are pulled
// in as tasks (source = "google").
model CalendarSource {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  googleAccountId String
  account         GoogleAccount @relation(fields: [googleAccountId], references: [id], onDelete: Cascade)
  calendarId      String
  calendarName    String
  projectId       String
  project         Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  syncToken       String?       // Google incremental sync token
  lastSyncedAt    DateTime?
  createdAt       DateTime      @default(now())

  @@unique([googleAccountId, calendarId])
  @@index([userId])
  @@index([projectId])
}

// A connected Notion workspace (OAuth). A user may connect many workspaces.
model NotionAccount {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId   String
  workspaceName String
  workspaceIcon String?
  botId         String
  accessToken   String
  createdAt     DateTime @default(now())
  notionSources NotionSource[]

  @@unique([userId, workspaceId])
  @@index([userId])
}

// Binds a Notion database (optionally a specific view) to a project, with the
// property mapping used to sync date + done-state. Two-way: local completion
// writes back to the mapped status property.
model NotionSource {
  id               String        @id @default(cuid())
  userId           String
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  notionAccountId  String
  account          NotionAccount @relation(fields: [notionAccountId], references: [id], onDelete: Cascade)
  databaseId       String
  databaseName     String
  viewId           String?
  projectId        String
  project          Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  datePropertyId   String?       // property → task scheduledAt/startTime
  statusPropertyId String?       // property representing "done"
  statusPropType   String?       // "checkbox" | "status" | "select"
  doneValue        String?       // status/select option name that means done
  filters          String?       // JSON array of row-sync filter conditions
  lastSyncedAt     DateTime?
  createdAt        DateTime      @default(now())

  @@unique([notionAccountId, databaseId])
  @@index([userId])
  @@index([projectId])
}

// Maps a Telegram account (from.id) to an app user. Created when the user
// redeems a short-lived link code (generated in-app) via /start or /link in
// the bot. One Telegram account links to exactly one user; re-linking moves it.
model TelegramLink {
  telegramUserId String   @id
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chatId         String
  username       String?
  createdAt      DateTime @default(now())

  @@index([userId])
}

// Short-lived one-time code generated by an authenticated user in the app and
// typed into the bot to prove ownership of the account before linking.
model TelegramLinkCode {
  code      String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// Stage-1 analytics: fire-and-forget events for DAU, funnel, AI cost.
// Schema is intentionally generic — `event` is the verb, `props` is a JSON
// blob for anything route-specific (e.g. provider, durationMs, cost).
model AnalyticsEvent {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  event     String
  props     String?  // JSON-encoded
  createdAt DateTime @default(now())

  @@index([event, createdAt])
  @@index([userId, createdAt])
}

model Project {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  avatarType String   @default("auto") // auto | emoji | image
  emoji      String?
  image      String? // base64 data URL
  hue        Int? // 0-360 override for the generated avatar
  hidden     Boolean  @default(false)
  capitalization String @default("sentence") // sentence | lower | capitalized | upper
  order      Int      @default(0)
  parents    ProjectParent[] @relation("ChildToParents")
  children   ProjectParent[] @relation("ParentToChildren")
  tasks      Task[]
  calendarSources CalendarSource[]
  notionSources   NotionSource[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  deletedAt  DateTime?

  @@unique([userId, name])
  @@index([userId])
  @@index([userId, updatedAt])
}

// DAG: a project can have any number of parents (and children).
// onDelete: Cascade so removing a project tidies its edges.
model ProjectParent {
  childId  String
  parentId String
  child    Project @relation("ChildToParents", fields: [childId], references: [id], onDelete: Cascade)
  parent   Project @relation("ParentToChildren", fields: [parentId], references: [id], onDelete: Cascade)

  @@id([childId, parentId])
  @@index([parentId])
}

model Task {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  text        String
  completed   Boolean   @default(false)
  completedAt DateTime?
  order       Int       @default(0)
  // Which fixed bucket the task lives in: "today" | "week" | "later".
  // "overdue" is purely derived (today/week tasks whose scheduledAt period
  // has passed and that are still incomplete) — never written.
  bucket      String    @default("later")
  // Stamped whenever bucket is set to "today" or "week". Used to decide
  // whether such a task should appear in the Overdue display bucket.
  scheduledAt DateTime?
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId   String?
  startTime   DateTime?
  duration    Int? // minutes
  // External-source provenance. "manual" tasks are created in-app; "google" /
  // "notion" tasks mirror an external item and are upserted by the sync engine.
  source           String    @default("manual") // manual | google | notion
  externalId       String?   // provider item id (calendar event id / notion page id)
  externalSourceId String?   // CalendarSource.id or NotionSource.id
  externalUrl      String?
  externalUpdatedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@unique([externalSourceId, externalId])
  @@index([userId])
  @@index([userId, updatedAt])
  @@index([externalSourceId])
}
