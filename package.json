{
  "name": "eos",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "setup": "devkit setup",
    "secrets:push": "devkit secrets push",
    "secrets:pull": "devkit secrets pull",
    "dev": "devkit",
    "dev:open": "devkit --open",
    "ios": "bun --filter frontend ios",
    "ios:prod": "bun --filter frontend ios:prod",
    "lint": "biome lint .",
    "format": "biome format . --write",
    "check": "biome check .",
    "release": "release-ios"
  },
  "devkit": {
    "apps": [
      {
        "name": "backend",
        "cwd": "apps/backend",
        "port": 1e4,
        "color": "blue"
      },
      {
        "name": "frontend",
        "cwd": "apps/frontend",
        "port": 3000,
        "color": "magenta",
        "open": true
      }
    ],
    "setup": {
      "secrets": [".env", "infra/terraform.tfvars"],
      "env": [
        {
          "file": ".env",
          "example": ".env.example"
        }
      ],
      "terraform": "infra",
      "steps": [
        "ln -sfn ../../.env apps/backend/.env",
        "ln -sfn ../../.env apps/frontend/.env",
        "bun --filter backend prisma:generate"
      ]
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "@elumixor/devkit": "^0.4.1",
    "@elumixor/release-ios": "^0.1.2",
    "@libsql/client": "^0.17.2",
    "@types/bun": "^1.3.14",
    "typescript": "^5.8.3"
  }
}
