{
  "name": "eos",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "devkit dev",
    "dev:open": "devkit dev --open",
    "ios": "bun --filter frontend ios",
    "ios:prod": "bun --filter frontend ios:prod",
    "lint": "biome lint .",
    "format": "biome format . --write",
    "check": "biome check .",
    "release": "release-ios"
  },
  "devkit": {
    "apps": [
      { "name": "backend", "cwd": "apps/backend", "port": 10000, "color": "blue" },
      { "name": "frontend", "cwd": "apps/frontend", "port": 3000, "color": "magenta", "open": true }
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "@elumixor/devkit": "^0.1.2",
    "@elumixor/release-ios": "^0.1.2",
    "@libsql/client": "^0.17.2",
    "typescript": "^5.8.3"
  }
}
